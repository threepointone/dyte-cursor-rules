<details>
<summary>create breakout room and redirect participants (serverless)</summary>

```ts
// pages/api/breakout.ts (next.js example)
import { NextApiRequest, NextApiResponse } from 'next';
import axios from 'axios';

export default async function handler(req: NextApiRequest, res: NextApiResponse) {
  const { parentMeetingId, topic } = req.body;
  const { data } = await axios.post(
    `https://api.cluster.dyte.in/v2/meetings/${parentMeetingId}/group-calls`,
    { title: topic },
    { headers: { Authorization: `Bearer ${process.env.DYTE_ORG_API_KEY}` } }
  );
  res.json({ meetingId: data.id });
}
```

```tsx
// client redirect
const { data } = await fetch('/api/breakout', { method: 'POST', body: JSON.stringify({ parentMeetingId, topic: 'Debug Room' }) }).then(r => r.json());
window.location.href = `/meeting/${data.meetingId}`;
```

</details>

<details>
<summary>headless voice indicator overlay (gaming)</summary>

```tsx
import { useDyteMeeting } from '@dytesdk/react-web-core';

export const VoiceMeters = () => {
  const { participants } = useDyteMeeting();
  const speaking = participants.filter(p => p.audioEnabled && p.isSpeaking);
  return (
    <div className="absolute bottom-4 left-4 space-y-2">
      {speaking.map(p => (
        <div key={p.id} className="flex items-center gap-2">
          <img src={p.picture} className="w-6 h-6 rounded-full" />
          <div className="w-32 h-1 bg-gray-700">
            <div style={{ width: `${p.audioLevel * 100}%` }} className="h-1 bg-green-500" />
          </div>
        </div>
      ))}
    </div>
  );
};
```

</details>

