import { useDytePolls } from '@dytesdk/react-ui-kit';

export const PollCreator = () => {
  const { createPoll } = useDytePolls();
  const handleCreate = () =>
    createPoll({
      question: 'Rate today’s session',
      options: ['🔥', '👍', '🤔', '💤'],
      multiple: false,
      anonymous: true,
