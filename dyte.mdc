## additional recipe examples

<details>
<summary>start/stop cloud recording and capture recording ID</summary>

```tsx
import { DyteRecordingToggle, useDyteMeeting } from '@dytesdk/react-ui-kit';
import { useEffect } from 'react';

export function RecordButton() {
  const { recording, self } = useDyteMeeting();

  useEffect(() => {
    const fn = (evt: { recordingId: string }) => {
      console.log('recording started, id:', evt.recordingId);
    };
    recording.on('recordingStarted', fn);
    return () => recording.off('recordingStarted', fn);
  }, []);

  // only hosts may record
  if (!self.permissions.recording) return null;
  return <DyteRecordingToggle />;
}
```

</details>

<details>
<summary>quick poll creator for webinar hosts</summary>

